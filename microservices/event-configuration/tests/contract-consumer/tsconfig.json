{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": "../..",
    "paths": {
      "vitest": ["apps/configuration-api/node_modules/vitest"]
    },
    "typeRoots": ["../../apps/configuration-api/node_modules/@types", "../../node_modules/@types"],
    "types": ["node"]
  },
  "include": ["*.ts"]
}
