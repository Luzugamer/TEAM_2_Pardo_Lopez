# Solo desarrollo local. Copiar a .env y cambiar las contraseñas.
POSTGRES_DB=event_configuration
POSTGRES_USER=configuration_migrator
POSTGRES_PASSWORD=change-me-migrator-local
EVENTS_MIGRATOR_USER=events_migrator
EVENTS_MIGRATOR_PASSWORD=change-me-events-migrator-local
APP_DB_USER=configuration_app
APP_DB_PASSWORD=change-me-app-local
API_PORT=3000
ADMIN_PORT=8080
DB_PORT=5433
# El compose de desarrollo selecciona BROKER_MODE=simulator y NODE_ENV=development.
WORKER_TENANT_IDS=0194eb00-0000-7000-8000-000000000001,0194eb00-0000-7000-8000-000000000002
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=10
WORKER_LEASE_SECONDS=60
WORKER_MAX_BACKOFF_SECONDS=300
# Falla la primera entrega para observar el retry; usar 0 para desactivarlo.
SIMULATOR_FAIL_FIRST_N=1
SIMULATOR_FAIL_EVERY_N=0
# Configure only after the project's privacy owner approves the exact notice and version.
SPEAKER_CONSENT_NOTICE_TEXT=
SPEAKER_CONSENT_NOTICE_VERSION=
